{
    "$schema": "vscode://schemas/color-theme",
    "name": "Business Central Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1E1E1E", // Dark background for the editor
        "editor.foreground": "#D4D4D4", // Neutral foreground for readability
        "editor.inactiveSelectionBackground": "#003A40", // Dark teal for inactive selection
        "editor.selectionBackground": "#093B42", // Teal for active selection
        "editorIndentGuide.background1": "#404040", // Subtle neutral for indent guides
        "editorIndentGuide.activeBackground1": "#00747F", // Teal for active indent guides
        "editor.selectionHighlightBackground": "#005760", // Highlighted selection in teal
        "editorSuggestWidget.background": "#252526", // Dark background for suggestions
        "activityBarBadge.background": "#00747F", // Teal for activity bar badges
        "sideBarTitle.foreground": "#A6A6A6", // Neutral foreground for sidebar titles
        "input.placeholderForeground": "#A6A6A6", // Neutral placeholder text
        "searchEditor.textInputBorder": "#005760", // Teal border for search input
        "settings.textInputBorder": "#005760", // Teal border for settings input
        "settings.numberInputBorder": "#005760", // Teal border for number input
        "statusBarItem.remoteForeground": "#FFFFFF", // White for remote status text
        "statusBarItem.remoteBackground": "#00747F", // Teal for remote status bar
        "statusBar.background": "#00747F", // Teal for remote status bar
        "sideBarSectionHeader.background": "#1E1E1E", // Match editor background
        "sideBarSectionHeader.border": "#093B42", // Dark teal for section header borders
        "button.background": "#00747F", // Teal for button backgrounds
        "list.activeSelectionBackground": "#005760", // Dark teal for active selection in lists
        "list.focusAndSelectionOutline": "#00A3AE", // Teal for focus and selection outline
        "list.focusOutline": "#00A3AE", // Teal for focus and selection outline
        "list.hoverBackground": "#093B42", // Dark teal for hover effect
        "list.hoverForeground": "#D4D4D4", // Neutral foreground for hover effect

        "editorBracketHighlight.foreground1": "#00747F", // Teal for level 1
        "editorBracketHighlight.foreground2": "#62CFD7", // Light teal for level 2
        "editorBracketHighlight.foreground3": "#005760", // Dark teal for level 3
        "editorBracketHighlight.foreground4": "#56616C", // Neutral gray for level 4
        "editorBracketHighlight.foreground5": "#A6A6A6", // Light neutral for level 5
        "editorBracketHighlight.foreground6": "#D4D4D4", // Softer neutral for level 6
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.deprecated": {
            "strikethrough": true,
            "foreground": "#D13438" // Red for deprecated items
        }
    },
    "tokenColors": [
        {
            "scope": "meta.embedded",
            "settings": {
                "foreground": "#D4D4D4" // Neutral for embedded code
            }
        },
        {
            "scope": "emphasis",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "strong",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#00747F" // Teal for diff headers
            }
        },
        {
            "scope": "comment",
            "settings": {
                "foreground": "#64707D" // Neutral gray for comments
            }
        },
        {
            "scope": "constant.language",
            "settings": {
                "foreground": "#62CFD7" // Light teal for language constants
            }
        },
        {
            "scope": [
                "constant.numeric",
                "entity.name.operator.custom-literal.number",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": {
                "foreground": "#9FD89F" // Green for numeric constants
            }
        },
        {
            "scope": "constant.regexp",
            "settings": {
                "foreground": "#C239B3" // Berry for regex constants
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#569CD6" // Blue for tags
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#9CDCFE" // Light blue for attributes
            }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#D13438" // Red for invalid tokens
            }
        },
        {
            "scope": "markup.underline",
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#00747F" // Teal for bold text
            }
        },
        {
            "scope": "markup.heading",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#00747F" // Teal for headings
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#9FD89F" // Green for inserted text
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#D13438" // Red for deleted text
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#00747F" // Teal for changed text
            }
        },
        {
            "scope": "string",
            "settings": {
                "foreground": "#CE9178" // Orange for strings
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#00747F" // Teal for keywords
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#9CDCFE" // Light blue for variables
            }
        },
        {
            "scope": "entity.name.function",
            "settings": {
                "foreground": "#DCDCAA" // Yellow for function names
            }
        },
        {
            "scope": "entity.name.type",
            "settings": {
                "foreground": "#4EC9B0" // Aqua for types
            }
        },
        {
            "scope": "entity.name.class",
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        {
            "scope": "entity.name.namespace",
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        {
            "scope": "entity.name.enum",
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        {
            "scope": "entity.name.interface",
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        {
            "name": "Xml Documentation Comment",
            "scope": "comment.documentation",
            "settings": {
                "foreground": "#56616C" // Neutral gray for readability, from --color-neutral-foreground3
            }
        },
        {
            "name": "Xml Documentation Comment Attribute",
            "scope": "comment.documentation.attribute",
            "settings": {
                "foreground": "#00747F" // Teal for attributes, from --color-brand-foreground1
            }
        },
        {
            "name": "Xml Documentation Comment CDATA",
            "scope": "comment.documentation.cdata",
            "settings": {
                "foreground": "#62CFD7" // Light teal for CDATA, from --color-brand-stroke2
            }
        },
        {
            "name": "Xml Documentation Comment Delimiter",
            "scope": "comment.documentation.delimiter",
            "settings": {
                "foreground": "#569CD6" // Blue for delimiters, from --color-palette-blue-foreground2
            }
        },
        {
            "name": "Xml Documentation Comment Name",
            "scope": "comment.documentation.name",
            "settings": {
                "foreground": "#B5BDC4" // Neutral gray for names, from --color-neutral-foreground-disabled
            }
        },
        {
            "name": "Json property name",
            "scope": "support.type.property-name.json",
            "settings": {
                "foreground": "#4EC9B0"
            }
        }
    ]
}
