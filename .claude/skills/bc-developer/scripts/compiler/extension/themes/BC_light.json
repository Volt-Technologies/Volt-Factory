{
    "$schema": "vscode://schemas/color-theme",
    "name": "Business Central Light",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#202428",
        "editor.inactiveSelectionBackground": "#D9F0F2",
        "editorIndentGuide.background1": "#E3E6E8",
        "editorIndentGuide.activeBackground1": "#00747F",
        "editor.selectionHighlightBackground": "#8ADBE1",
        "editorSuggestWidget.background": "#F3F3F3",
        "activityBarBadge.background": "#00747F",
        "sideBarTitle.foreground": "#3B424A",
        "input.placeholderForeground": "#56616C",
        "searchEditor.textInputBorder": "#CECECE",
        "settings.textInputBorder": "#CECECE",
        "settings.numberInputBorder": "#CECECE",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "statusBarItem.remoteBackground": "#00747F",
        "statusBar.background": "#00747F",
        "sideBarSectionHeader.background": "#FFFFFF",
        "sideBarSectionHeader.border": "#D9F0F2",
        "button.background": "#00747F", // Teal for button backgrounds,
        "list.activeSelectionBackground": "#005760", // Dark teal for active selection in lists
        "list.focusAndSelectionOutline": "#00A3AE", // Teal for focus and selection outline
        "list.focusOutline": "#00A3AE", // Teal for focus and selection outline
        "list.hoverBackground": "#093B42", // Dark teal for hover effect
        "list.hoverForeground": "#D4D4D4", // Neutral foreground for hover effect

        "editorBracketHighlight.foreground1": "#005760", // Dark teal for level 1
        "editorBracketHighlight.foreground2": "#00747F", // Teal for level 2
        "editorBracketHighlight.foreground3": "#33C1CC", // Light teal for level 3
        "editorBracketHighlight.foreground4": "#56616C", // Neutral gray for level 4
        "editorBracketHighlight.foreground5": "#A6A6A6", // Light neutral for level 5
        "editorBracketHighlight.foreground6": "#D4D4D4", // Softer neutral for level 6
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.deprecated": {
            "strikethrough": true,
            "foreground": "#D13438"
        }
    },
    "tokenColors": [
        {
            "scope": [
                "meta.embedded",
            ],
            "settings": {
                "foreground": "#202428"
            }
        },
        {
            "scope": "emphasis",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "strong",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#00747F"
            }
        },
        {
            "scope": "comment",
            "settings": {
                "foreground": "#56616C"
            }
        },
        {
            "scope": "constant.language",
            "settings": {
                "foreground": "#00747F"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "entity.name.operator.custom-literal.number",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": {
                "foreground": "#098658"
            }
        },
        {
            "scope": "constant.regexp",
            "settings": {
                "foreground": "#811F3F"
            }
        },
        {
            "name": "CSS tags in selectors, XML tags",
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#800000"
            }
        },
        {
            "scope": "entity.name.selector",
            "settings": {
                "foreground": "#800000"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#FF0000"
            }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#D13438"
            }
        },
        {
            "scope": "markup.underline",
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#00747F"
            }
        },
        {
            "scope": "markup.heading",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#00747F"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#098658"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#D13438"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#00747F"
            }
        },
        {
            "scope": "storage",
            "settings": {
                "foreground": "#00747F"
            }
        },
        {
            "scope": "string",
            "settings": {
                "foreground": "#A31515"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#00747F"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#001080"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": {
                "foreground": "#795E26"
            }
        },
        {
            "scope": "entity.name.type",
            "settings": {
                "foreground": "#267F99"
            }
        },
        {
            "scope": "entity.name.class",
            "settings": {
                "foreground": "#267F99"
            }
        },
        {
            "scope": "entity.name.namespace",
            "settings": {
                "foreground": "#267F99"
            }
        },
        {
            "scope": "entity.name.enum",
            "settings": {
                "foreground": "#267F99"
            }
        },
        {
            "scope": "entity.name.interface",
            "settings": {
                "foreground": "#267F99"
            }
        },
        {
            "name": "Xml Documentation Comment",
            "scope": "comment.documentation",
            "settings": {
                "foreground": "#3B424A" // Neutral gray for readability, from --color-neutral-foreground2
            }
        },
        {
            "name": "Xml Documentation Comment Attribute",
            "scope": "comment.documentation.attribute",
            "settings": {
                "foreground": "#00747F" // Teal for attributes, from --color-brand-foreground1
            }
        },
        {
            "name": "Xml Documentation Comment CDATA",
            "scope": "comment.documentation.cdata",
            "settings": {
                "foreground": "#33C1CC" // Light teal for CDATA, from --color-brand-background2-pressed
            }
        },
        {
            "name": "Xml Documentation Comment Delimiter",
            "scope": "comment.documentation.delimiter",
            "settings": {
                "foreground": "#005760" // Dark teal for delimiters, from --color-brand-background3-static
            }
        },
        {
            "name": "Xml Documentation Comment Name",
            "scope": "comment.documentation.name",
            "settings": {
                "foreground": "#56616C" // Neutral gray for names, from --color-neutral-foreground3
            }
        },
        {
            "name": "Json property name",
            "scope": "support.type.property-name.json",
            "settings": {
                "foreground": "#56616C"
            }
        }
    ]
}
