# Business Central Apps Configuration
# This file configures paths, credentials, and options for BC app compilation and publishing

# ============================================================================
# COMPILATION CONFIGURATION
# ============================================================================

# Root directory containing BC apps (can contain multiple apps with app.json files)
# The compiler will recursively search for all app.json files under this path
# Default: BC
BC_APPS_ROOT=BC

# Optional: Custom compiler path
# If not set, uses: scripts/compiler/extension/bin/{OS}/alc
# BC_COMPILER_PATH=

# Optional: Custom package cache directory for dependencies
# If not set, uses: {app_folder}/.alpackages for each app
# BC_PACKAGE_CACHE=

# Optional: Custom output directory for compiled apps
# If not set, outputs to: {app_folder}/{app_name}.app
# BC_OUTPUT_DIR=

# ============================================================================
# PUBLISHING CONFIGURATION
# ============================================================================

# === DEPLOYMENT TARGET ===
# Deployment type: "online" (SaaS/Cloud) or "local" (Docker/On-premises)
# - online: Uses OAuth authentication, Microsoft cloud endpoints
# - local: Uses NavUserPassword authentication, local server URLs
BC_DEPLOYMENT_TYPE=online

# Environment type: "sandbox" or "production"
# - sandbox: For development and testing (supports Dev mode publishing)
# - production: For production releases (PTE mode only)
BC_ENVIRONMENT_TYPE=sandbox

# === ONLINE/SAAS AUTHENTICATION (OAuth 2.0) ===
# Required when BC_DEPLOYMENT_TYPE=online
# Get these from Azure AD App Registration

# Azure AD Tenant ID (Directory ID)
BC_TENANT_ID=74d19fe7-2ea1-489b-9211-9a2ae69e0d10

# App Registration Client ID (Application ID)
BC_CLIENT_ID=4c57917c-d62e-44f8-9139-9f39b4ea4215

# App Registration Client Secret (from Certificates & secrets)
BC_CLIENT_SECRET=C3V8Q~C6LTup_II3tu6EGXXq39fGu4rtcD.MgaOz

# OAuth scope for Business Central API
BC_OAUTH_SCOPE=https://api.businesscentral.dynamics.com/.default

# === LOCAL/DOCKER AUTHENTICATION (NavUserPassword) ===
# Required when BC_DEPLOYMENT_TYPE=local
# Uses Basic Authentication with BC user credentials

# BC Username (must have appropriate permissions)
BC_LOCAL_USERNAME=

# BC User Password
BC_LOCAL_PASSWORD=

# Local BC Server URL (e.g., http://localhost:7048 or http://bcserver:7048)
BC_LOCAL_SERVER_URL=

# === ENVIRONMENT CONFIGURATION ===

# Environment name (for online: as shown in Admin Center; for local: instance name)
BC_ENVIRONMENT_NAME=Apparel

# Company ID (GUID) - Used for API calls that require company context
# Find this in BC: Search for "Companies" -> API Setup
BC_COMPANY_ID=04d0bd15-eb56-f011-8eee-6045bdc89b82

# === OPTIONAL: MULTIPLE ENVIRONMENT SUPPORT ===
# Define additional environments for easy switching

# Sandbox environment name
BC_SANDBOX_ENV_NAME=

# Production environment name
BC_PRODUCTION_ENV_NAME=


# Azure Devops Configuration
DEVOPS_SERVER_URL=https://dev.azure.com/VoltBC/

DEVOPS_PROJECT_NAME=Factory

DEVOPS_PERSONAL_TOKEN=2IuiGd1v9AbXnysPidVeJ6mejeozYRveBFbodMeqeoCIXK8NDlSKJQQJ99BJACAAAAAyZ7RBAAASAZDO3Ebp
